<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="%LANG:StartupManagerTitle%"
        Width="640"
        SizeToContent="Height"
        MaxHeight="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False">

    <Border BorderBrush="{DynamicResource AppBorderColor}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource CardBgColor}"
            Margin="25">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                            Opacity="0.15"
                            BlurRadius="20"
                            ShadowDepth="0"
                            Direction="0"/>
        </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" x:Name="TitleBar" Style="{DynamicResource ModalTitleBarStyle}">
                <TextBlock x:Name="TitleText"
                           Text="%LANG:StartupManagerTitle%"
                           Style="{DynamicResource ModalTitleTextStyle}"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,12,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="%LANG:StartupManagerIntro%"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="19"
                           Foreground="{DynamicResource AppFgColor}"
                           Opacity="0.85"
                           Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360" Padding="0,0,12,0">
                    <StackPanel x:Name="EntriesPanel"/>
                </ScrollViewer>

                <TextBlock x:Name="StatusText"
                           Grid.Row="2"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource AppFgColor}"
                           Opacity="0.85"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Button Panel -->
            <Border Grid.Row="2"
                    Background="{DynamicResource AppBgColor}"
                    BorderBrush="{DynamicResource AppBorderColor}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12"
                    CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CloseBtn"
                            Grid.Column="1"
                            Content="%LANG:StartupManagerClose%"
                            Style="{DynamicResource ModalPrimaryStretchedButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
